# Port for Express server
PORT=5000

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Python Agent FastAPI Service URL
AGENT_SERVICE_URL=http://localhost:8000

# MongoDB Atlas Connection String
MONGODB_URI=<ask-user>

# JWT Secret for Signing Authentication Tokens (generate with `openssl rand -base64 32`)
JWT_SECRET=<ask-user>

# SMTP Configuration for sending deletion requests (Nodemailer)
SMTP_HOST=<ask-user>
SMTP_PORT=587
SMTP_USER=<ask-user>
SMTP_PASS=<ask-user>
SMTP_FROM_EMAIL=<ask-user>
