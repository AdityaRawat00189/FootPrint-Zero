# FastAPI Service Port
PORT=8000
HOST=0.0.0.0

# MongoDB URI for state checkpointing and broker collections
MONGODB_URI=<ask-user>

# LLM API Key (Google Gemini / OpenAI / Anthropic)
GEMINI_API_KEY=<ask-user>
GOOGLE_API_KEY=<ask-user>
OPENAI_API_KEY=<ask-user>
ANTHROPIC_API_KEY=<ask-user>

# Have I Been Pwned API Key (Optional / fallback to realistic mock mode if absent)
HIBP_API_KEY=<ask-user>

# ChromaDB Vector Store Path (Local persistent storage)
CHROMA_PERSIST_DIRECTORY=./chroma_db
